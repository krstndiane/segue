# ---- API (apps/api) ----
PORT=8787
# Which places source to use: osm (free, default) | google | mock (offline demo data)
PLACES_PROVIDER=osm
# Only needed when PLACES_PROVIDER=google
GOOGLE_PLACES_API_KEY=
# Identifies Segue to OpenStreetMap's place-name service (Nominatim asks for a real User-Agent with contact details)
# NOMINATIM_USER_AGENT=Segue day planner (you@example.com)
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Max re-routes per IP per hour
REROUTE_RATE_LIMIT=60
# Smart add ("Let Segue read it"): on automatically when ANTHROPIC_API_KEY is set; SMART_ADD=off turns it off
ANTHROPIC_API_KEY=
# SMART_ADD=off
# Max smart-add notes per IP per hour (each one is a paid Claude call)
SMART_ADD_RATE_LIMIT=40
# Max smart-add notes per day across everyone (0 = no cap). Also set a spend limit in the Anthropic Console.
SMART_ADD_DAILY_CAP=300
# Max places / weather / place-name lookups per IP per hour (each can reach a free service that bans heavy callers)
READ_RATE_LIMIT=300

# Behind a host or proxy? Rate limits need the real client address.
# Proxies in front of the server that each add an address to x-forwarded-for (1 on most hosts, 2 if a CDN sits in front too).
TRUSTED_PROXY_HOPS=1
# Or name a header your host sets to the client IP (for example x-real-ip). It wins over x-forwarded-for.
# CLIENT_IP_HEADER=x-real-ip

# ---- Accounts, notes and invitations (optional) ----
# Postgres, e.g. Supabase → Connect → "Session pooler" connection string (with your database password).
# Leave empty to keep accounts off; the planner works without them.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# require (default, encrypted) | verify (also checks the certificate; set DATABASE_CA to Supabase's CA) | off (local only)
# DATABASE_SSL=require
# New database migrations run when the server starts; MIGRATE_ON_START=off to run them yourself (pnpm --filter @segue/api migrate)
# MIGRATE_ON_START=off
# https://<your-project>.supabase.co : sign-ins are checked against its public keys
# SUPABASE_URL=
# Only for older projects that sign tokens with a shared secret (HS256)
# SUPABASE_JWT_SECRET=
# Lets "Delete my account" remove the sign-in too. Server only, never in the web app.
# SUPABASE_SERVICE_ROLE_KEY=
# Per signed-in person per hour
# SOCIAL_WRITE_RATE_LIMIT=300
# SEARCH_RATE_LIMIT=60

# ---- Web (apps/web) ----
VITE_API_URL=http://localhost:8787

# Identifies this deployment to MET Norway (weather fallback). Use a real contact.
# WEATHER_USER_AGENT=Segue day planner (you@example.com)
