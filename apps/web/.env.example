# Copy to apps/web/.env and fill in. Vite reads these at build/dev time.

# Where the Segue API runs (defaults to http://localhost:8787)
# VITE_API_URL=http://localhost:8787

# Google Calendar: an OAuth client ID of type "Web application" (see README).
# Leave unset to hide the Google Calendar card.
VITE_GOOGLE_CLIENT_ID=

# Segue accounts (sync, notes, hearts, invitations) through Supabase Auth.
# Supabase → Project Settings → API: the Project URL and the public "anon" / publishable key.
# The public key is safe in the browser: the tables live in a schema it can't reach.
# Leave both empty to hide accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sky previews (?sky=storm&time=17:30&lat=&lng=) work in `vite dev` only.
# Set this to true to keep them in a production build for a design review.
# Never set it for the build real people use.
# VITE_ENABLE_SKY_PREVIEW=true
